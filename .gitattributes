# 统一用 LF，避免 Windows 上编辑产生整文件 diff
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ass text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp4 binary
*.wav binary
*.pth binary
*.safetensors binary

# 二进制资源：不能做行尾转换
*.woff2 binary
*.ico binary
*.exe binary
*.dll binary
